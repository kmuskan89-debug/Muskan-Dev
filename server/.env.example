# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Production / Primary URI
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/muskan_portfolio?retryWrites=true&w=majority

# Dedicated Test Database URI (strictly used by automated tests)
MONGO_URI_TEST=mongodb+srv://<username>:<password>@cluster0.mongodb.net/muskan_portfolio_test?retryWrites=true&w=majority

# JWT Authentication Secret (use a strong random 256-bit string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (for CORS allowlist)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
